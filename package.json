{
  "name": "hello-norway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "tsoa:spec": "tsoa spec",
    "tsoa:routes": "tsoa routes",
    "tsoa:build": "tsoa spec-and-routes",
    "dev:server": "npm run tsoa:build && nodemon --watch src --ignore src/generated/** --ext ts --exec 'npm run tsoa:build && ts-node --swc src/server.ts'",
    "start:server": "ts-node --swc src/server.ts",
    "dev:client": "next dev --port 3000",
    "dev:client:experimental": "next dev --port 3000 --experimental-https",
    "build": "npm run tsoa:build && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test": "node scripts/test-runner.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:ui": "vitest --ui",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:all:parallel": "concurrently \"npm run test:unit\" \"npm run test:e2e\"",
    "test:ci": "npm run test:unit:coverage && npm run test:e2e",
    "test:quick": "vitest run --reporter=dot && playwright test --reporter=dot"
  },
  "dependencies": {
    "@getbrevo/brevo": "^5",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "lucide-react": "^0.577.0",
    "next": "^16.2.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.5.0",
    "tsoa": "^7.0.0-alpha.0"
  },
  "overrides": {
    "vite": ">=8.0.5",
    "path-to-regexp": ">=8.4.0",
    "effect": ">=3.20.0",
    "defu": ">=6.1.5",
    "picomatch": ">=2.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@swc/core": "^1.15.18",
    "@tailwindcss/postcss": "^4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.2.4",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
