				"type": "object",
				"additionalProperties": false
			},
			"OnboardingProfileDto": {
				"properties": {
					"isEU": {
						"type": "boolean",
						"nullable": true,
						"description": "Is the user from an EU country?",
						"example": true
					},
					"hasChildren": {
						"type": "boolean",
						"nullable": true,
						"description": "Does the user have children?",
						"example": false
