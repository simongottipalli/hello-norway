							}
						},
						"required": [
							"name",
							"email",
							"id"
						],
						"type": "object"
					}
				},
				"required": [
					"message",
					"success",
					"sessionToken",
					"user"
				],
				"type": "object",
				"additionalProperties": false
			},
			"VerifyOtpDto": {
				"properties": {
					"email": {
						"type": "string",
						"description": "User email address",
						"example": "user@example.com",
						"format": "email",
						"maxLength": 320
					},
					"code": {
						"type": "integer",
						"format": "int32",
						"description": "6-digit OTP code",
						"example": 123456,
						"minimum": 100000,
						"maximum": 999999
					}
				},
				"required": [
					"email",
					"code"
				],
				"type": "object",
				"additionalProperties": false
			},
			"OnboardingTaskPreviewDto": {
				"properties": {
					"id": {
						"type": "string",
						"description": "Task identifier",
						"example": "c3b2a1d0-0000-4000-8000-000000000001"
					},
					"title": {
						"type": "string",
						"description": "Task title",
						"example": "Register with the police"
					},
					"shortDescription": {
						"type": "string",
						"nullable": true,
