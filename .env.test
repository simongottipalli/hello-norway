# Test environment — safe to commit, no real secrets.
# Loaded automatically by Vitest before .env.
# Used by the devcontainer and any agent running tests locally.

NODE_ENV=test

# ─── Application ─────────────────────────────────────────────────────────────
PORT=3000
API_PORT=3001
API_BASE_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Matches docker-compose.test.yml (hello_norway_test DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hello_norway_test

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_COOKIE_SECRET=test-session-secret-not-for-production

# ─── Email ────────────────────────────────────────────────────────────────────
# Uses the stub provider — no real emails are sent during tests
EMAIL_PROVIDER=test
EMAIL_FROM=test@example.com
BREVO_API_KEY=test-api-key

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=warn
