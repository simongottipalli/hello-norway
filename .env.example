# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development

# Port the Next.js frontend server listens on
PORT=3000

# Port the Express backend server listens on
API_PORT=3001

# URL Next.js API routes use to forward requests to Express (must match API_PORT)
API_BASE_URL=http://localhost:3001/api

# Public URL used for Open Graph metadata (set to your domain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# Credentials used by the bundled Docker Compose postgres service.
# If you use an external database, set DATABASE_URL directly and leave these blank.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME_with_a_strong_password
POSTGRES_DB=hello_norway

# PostgreSQL connection string.
# Docker Compose: use the service name "postgres" as the host
# Local (non-Docker):     replace "postgres" host with "localhost"
# Railway / Supabase / Neon: paste the full URL provided by your host
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ─── Session ─────────────────────────────────────────────────────────────────
# Secret used to sign session cookies — MUST be changed before deploying.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=REPLACE_ME_with_a_long_random_secret

# ─── Email ───────────────────────────────────────────────────────────────────
# Supported providers: brevo
EMAIL_PROVIDER=brevo

# The "From" address shown to recipients
EMAIL_FROM=noreply@example.com

# Brevo (formerly Sendinblue) API key — found in Brevo dashboard → SMTP & API → API Keys
BREVO_API_KEY=your-brevo-api-key

# ─── Logging ─────────────────────────────────────────────────────────────────
# Verbosity: debug | info | warn | error
# Recommended: debug in development, info in production
LOG_LEVEL=debug
