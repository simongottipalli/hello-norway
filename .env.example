# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development

# Port the Next.js frontend server listens on
PORT=3000

# Port the Express backend server listens on
API_PORT=3001

# URL Next.js API routes use to forward requests to Express (must match API_PORT)
API_BASE_URL=http://localhost:3001

# Public URL used for Open Graph metadata (set to your domain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local: postgresql://postgres:postgres@localhost:5432/hello_norway
# Railway: provided automatically when you link a database service
# Supabase: found in Project Settings → Database → Connection string (URI mode)
# Neon: found in your project dashboard under "Connection Details"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hello_norway

# ─── Session ─────────────────────────────────────────────────────────────────
# Secret used to sign session cookies — use a long, random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=change-me-to-a-long-random-secret

# ─── Email ───────────────────────────────────────────────────────────────────
# Supported providers: brevo
EMAIL_PROVIDER=brevo

# The "From" address shown to recipients
EMAIL_FROM=noreply@example.com

# Brevo (formerly Sendinblue) API key — found in Brevo dashboard → SMTP & API → API Keys
BREVO_API_KEY=your-brevo-api-key

# ─── Logging ─────────────────────────────────────────────────────────────────
# Verbosity: debug | info | warn | error
# Recommended: debug in development, info in production
LOG_LEVEL=debug
