# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development

# Port the Next.js frontend server listens on
PORT=3000

# Port the Express backend server listens on
API_PORT=3001

# URL Next.js API routes use to forward requests to Express (must match API_PORT)
API_BASE_URL=http://localhost:3001/api

# Public URL used for Open Graph metadata (set to your domain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string (credentials, host, port, and database name in one URL).
# Docker Compose: keep the host as "postgres" (the Compose service name)
# Local (non-Docker):      change the host to "localhost"
# Railway / Supabase / Neon: paste the full URL provided by your host
DATABASE_URL=postgresql://postgres:REPLACE_ME_with_a_strong_password@postgres:5432/hello_norway

# ─── Session ─────────────────────────────────────────────────────────────────
# Secret used to sign session cookies — MUST be changed before deploying.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=REPLACE_ME_with_a_long_random_secret

# ─── Admin portal ─────────────────────────────────────────────────────────────
# URL path segment for the admin portal (no leading slash, e.g. "secure-portal").
# Avoid obvious names like "admin" or "adminlogin".
ADMIN_PATH=REPLACE_ME_with_an_obscure_path_segment

# Secret used to sign admin session cookies — MUST differ from SESSION_COOKIE_SECRET.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_COOKIE_SECRET=REPLACE_ME_with_a_different_long_random_secret

# Email address of the initial admin user created by the seed script.
ADMIN_SEED_EMAIL=admin@example.com

# ─── Email ───────────────────────────────────────────────────────────────────
# Supported providers: brevo
EMAIL_PROVIDER=brevo

# The "From" address shown to recipients
EMAIL_FROM=noreply@example.com

# Brevo (formerly Sendinblue) API key — found in Brevo dashboard → SMTP & API → API Keys
BREVO_API_KEY=your-brevo-api-key

# ─── API Documentation ───────────────────────────────────────────────────────
# Set to true to enable Swagger UI at /api-docs
API_DOCS_ENABLED=true

# ─── Logging ─────────────────────────────────────────────────────────────────
# Verbosity: debug | info | warn | error
# Recommended: debug in development, info in production
LOG_LEVEL=debug
