						"$ref": "#/components/schemas/TaskCategory",
						"description": "Task category used for grouping and ordering",
						"example": "ARRIVAL"
					},
					"sortOrder": {
						"type": "number",
						"format": "double",
						"description": "Relative ordering within a category",
						"example": 20
